<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- 제목 -->
        <TextView
            android:id="@+id/elevatorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1번 엘리베이터"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="32dp"
            android:fontFamily="@font/gmarketsans_bold" />

        <!-- 신호등 이미지: 크기 고정 -->
        <ImageView
            android:id="@+id/signalImage"
            android:layout_width="200dp"
            android:layout_height="300dp"
            android:scaleType="fitCenter"
            android:src="@drawable/off"
            android:contentDescription="신호등 상태"
            android:layout_marginBottom="32dp" />

        <!-- NFC 버튼 -->
        <Button
            android:id="@+id/nfcButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NFC 태깅"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/gmarketsans_medium"
            android:background="@drawable/rounded_button_blue"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="16dp" />
    </LinearLayout>
</ScrollView>
